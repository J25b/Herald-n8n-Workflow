    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Write one email for this brief.\\n\\nBrief: {{ $json.brief }}\\nTone: {{ $json.tone }}\\nSender name: {{ $json.senderName }}\\nSubject: {{ $json.userSubject ? \"Use exactly this subject: \" + $json.userSubject : \"Suggest a fitting subject line.\" }}{{ $json.feedback ? \"\\n\\nYour previous draft was rejected. Reviewer feedback: \" + $json.feedback + \"\\n\\nPrevious draft:\\n\" + $json.previousBody + \"\\n\\nRewrite it so it addresses the feedback.\" : \"\" }}"
            }
          ]
        },
        "options": {
          "includeMergedResponse": true,
          "system": "You write one email that will be sent to a whole contact list. Start the body with \"Hi {{name}},\" using the literal placeholder {{name}} exactly as written. Keep it clear, professional and under 200 words unless the brief needs more. End with the sender name. Use plain text with blank lines between paragraphs. Do not invent facts, links or dates that are not in the brief. Return ONLY valid JSON with exactly two string fields, \"subject\" and \"body\". No markdown, no code fences.",
          "maxTokens": 1500
        }
      },
      "id": "37ce868e-04a0-40fc-b017-5953facce7ee",
      "name": "Draft Email with AI",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1024,
        304
      ],
      "executeOnce": true,
      "credentials": {
