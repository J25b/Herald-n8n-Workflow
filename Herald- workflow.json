    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json;\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst today = $now.toFormat('yyyy-MM-dd');\nlet sentToday = 0;\nlet skipped = 0;\nconst seen = {};\nconst valid = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const email = String(r.email || '').trim();\n  const status = String(r.status || '').trim().toLowerCase();\n  if (status === 'sent') {\n    if (String(r.sent_at || '').startsWith(today)) sentToday++;\n    skipped++;\n    continue;\n  }\n  if (!emailRe.test(email) || seen[email.toLowerCase()]) {\n    skipped++;\n    continue;\n  }\n  seen[email.toLowerCase()] = true;\n  valid.push({ name: String(r.name || '').trim(), email: email, attachment_file: String(r.attachment_file || '').trim() });\n}\nconst queue = cfg.testMode ? valid.slice(0, 3) : valid;\nconst remaining = Math.max(0, Number(cfg.dailyCap) - sentToday);\nreturn queue.map((c, idx) => ({\n  json: Object.assign({}, c, { route: idx < remaining ? 'send' : 'pending', skipped: skipped }),\n}));"
      },
