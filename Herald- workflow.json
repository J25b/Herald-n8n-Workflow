    {
      "parameters": {
        "jsCode": "const results = $input.all().map((i) => i.json);\nconst sent = results.filter((r) => r.status === 'sent').length;\nconst failed = results.filter((r) => r.status === 'failed').length;\nconst plan = $('Filter Contacts and Apply Cap').all();\nconst pending = plan.filter((i) => i.json.route === 'pending').length;\nconst skipped = plan.length ? plan[0].json.skipped : 0;\nconst subject = $('Parse Draft').last().json.subject;\nconst text = 'Herald run finished.\\n\\nSubject: ' + subject + '\\nSent: ' + sent + '\\nFailed: ' + failed + '\\nSkipped (empty/invalid email, duplicate or already sent): ' + skipped + '\\nPending (daily cap reached): ' + pending + '\\n\\nFailed rows have the error message in the sheet.';\nreturn [{ json: { sent: sent, failed: failed, skipped: skipped, pending: pending, text: text } }];"
      },
