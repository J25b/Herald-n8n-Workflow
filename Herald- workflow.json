    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nconst first = String(c.name || '').trim() || 'there';\nconst fill = (s) => String(s).replace(/\\{\\{\\s*name\\s*\\}\\}/gi, first);\nconst subject = fill(c.subject);\nconst text = fill(c.body);\nconst esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst paragraphs = esc(text).split(/\\n{2,}/).map((p) => '<p style=\"margin:0 0 14px 0;\">' + p.replace(/\\n/g, '<br>') + '</p>').join('');\nconst html = '<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#222;\">' + paragraphs + '</div>';\nreturn { json: { toEmail: c.email, name: c.name, attachment_file: c.attachment_file, subject: subject, text: text, html: html } };"
      },
