    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet text = raw.merged_response || '';\nif (!text && Array.isArray(raw.content)) {\n  const block = raw.content.find((c) => c.type === 'text');\n  text = block ? block.text : '';\n}\nconst start = text.indexOf('{');\nconst end = text.lastIndexOf('}');\nif (start === -1 || end === -1) {\n  throw new Error('The AI did not return JSON. Raw output: ' + text.slice(0, 300));\n}\nconst parsed = JSON.parse(text.slice(start, end + 1));\nconst userSubject = $('Prepare Draft Input').first().json.userSubject;\nconst subject = userSubject || String(parsed.subject || '').trim();\nconst body = String(parsed.body || '').trim();\nconst esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: { subject: subject, body: body, bodyHtml: esc(body).replace(/\\n/g, '<br>'), round: $runIndex } }];"
      },
